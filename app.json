{
  "expo": {
    "name": "MacroFit",
    "slug": "macrofit",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "macrofit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.macrofit.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "MacroFit needs photo access so you can analyse a meal photo and attach progress photos.",
        "NSCameraUsageDescription": "MacroFit uses the camera to analyse meals and take progress photos."
      }
    },
    "android": {
      "package": "com.macrofit.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C8261",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "MacroFit needs photo access so you can analyse a meal photo and attach progress photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9",
          "dark": { "backgroundColor": "#090C0A" }
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-connect-permissions",
      "./plugins/with-health-connect-delegate",
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
