{
  "expo": {
    "name": "MacroFit",
    "slug": "macrofit",
    "version": "1.4.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "macrofit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.macrofit.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "MacroFit needs photo access so you can analyse a meal photo and attach progress photos.",
        "NSCameraUsageDescription": "MacroFit uses the camera to analyse meals and take progress photos."
      }
    },
    "android": {
      "package": "com.macrofit.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C8261",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 12
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "MacroFit needs photo access so you can analyse a meal photo and attach progress photos.",
          "cameraPermission": "MacroFit uses the camera to analyse meals and take progress photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9",
          "dark": {
            "backgroundColor": "#090C0A"
          }
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-connect-permissions",
      "./plugins/with-health-connect-delegate",
      "./plugins/with-release-signing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0C8261",
          "sounds": [
            "./assets/sounds/rest_over.wav",
            "./assets/sounds/reminder.wav",
            "./assets/sounds/water.wav"
          ]
        }
      ],
      "expo-background-task",
      "@react-native-community/datetimepicker",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/fraunces/600SemiBold/Fraunces_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
            "./node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "Today",
              "previewImage": "./assets/widgets/today-preview.png",
              "description": "Calories and macros left, with one-tap logging",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "Training",
              "label": "Training",
              "previewImage": "./assets/widgets/training-preview.png",
              "description": "Your next session, one tap to start",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
