+): Record<string, unknown> {
+  if ('sizes' in widget && widget.sizes.length > 0) {
+    const sizes = widget.sizes.map(({ width, height, widget: one }) => ({
+      width,
+      height,
+      ...buildSingleWidgetConfig(one),
