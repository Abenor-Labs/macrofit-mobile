# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local secrets — never commit
.env
.export-test/


# Local tooling config
.claude/

# Release signing material — never commit
credentials/
.env.from-nested

# Signing key for the sideloaded release builds. Losing it means no further in-app
# updates can install over an existing copy — back it up outside this repo.
keys/
